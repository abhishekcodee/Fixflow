{
  "installCommand": "npm install --include=optional",
  "rewrites": [
    {
      "source": "/api/email-relay",
      "destination": "/api/email-relay"
    },
    {
      "source": "/api/:path*",
      "destination": "https://fixflowwww.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
