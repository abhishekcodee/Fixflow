# ==============================================================================
# FixFlow Backend Environment Configuration Template
# Copy this file to '.env' in the server directory and configure your local values.
# Do NOT commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Server Network Port
PORT=5000

# Application Environment ('development', 'production', 'test')
NODE_ENV=development

# MongoDB Connection String
# MySQL Database Connection (Prisma & XAMPP)
DATABASE_URL="mysql://root:@localhost:3306/fixflow"

# Client Application URL (For CORS Whitelisting)
CLIENT_URL=http://localhost:5173

# JWT Authentication Configuration
JWT_SECRET=replace_with_a_long_random_entropy_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# ==============================================================================
# Real Gmail SMTP Configuration (Using Google App Password)
# ==============================================================================
# 1. Go to Google Account Settings -> Security -> 2-Step Verification (Enable it).
# 2. Under "2-Step Verification", scroll down to "App Passwords".
# 3. Create a new App Password named "FixFlow".
# 4. Copy the generated 16-character password into SMTP_PASS below.
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_google_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=FixFlow Facilities Care

# ==============================================================================
# GitHub OAuth 2.0 Authentication
# ==============================================================================
# 1. Go to GitHub -> Settings -> Developer Settings -> OAuth Apps -> New OAuth App
# 2. Application name: FixFlow
# 3. Homepage URL: http://localhost:5173 (or your deployed URL)
# 4. Authorization callback URL: http://localhost:5173/auth/github/callback
# 5. Copy Client ID and generate a Client Secret.
# ==============================================================================
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

