datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id                  String    @id @default(uuid())
  name                String    @db.VarChar(60)
  email               String    @unique @db.VarChar(191)
  phone               String?   @unique @db.VarChar(30)
  passwordHash        String?   @db.VarChar(255)
  githubId            String?   @unique @db.VarChar(191)
  avatarUrl           String?   @db.Text
  role                String    @default("user") @db.VarChar(20)
  isActive            Boolean   @default(true)
  isVerified          Boolean   @default(false)
  
  // Identity verification (Aadhaar / ID Card)
  identityStatus      String    @default("unverified") @db.VarChar(30) // unverified, pending, verified, rejected
  identityType        String?   @db.VarChar(30) // aadhaar, pan, passport
  identityNumberMasked String?  @db.VarChar(30) // e.g. XXXX-XXXX-1234
  identityHash        String?   @db.VarChar(255) // SHA-256 hash for duplicate check without plaintext storage
  identityVerifiedAt  DateTime?
  identityProviderRef String?   @db.VarChar(100)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  createdComplaints   Complaint[]        @relation("ComplaintCreator")
  assignedComplaints  Complaint[]        @relation("ComplaintTechnician")
  historyActions      ComplaintHistory[] @relation("HistoryActor")
  technicianProfile   TechnicianProfile?

  @@index([role])
  @@index([identityStatus])
}

model Complaint {
  id                  String    @id @default(uuid())
  complaintNumber     String    @unique @db.VarChar(50)
  title               String    @db.VarChar(120)
  description         String    @db.Text
  category            String    @db.VarChar(50)
  priority            String    @default("medium") @db.VarChar(20)
  status              String    @default("submitted") @db.VarChar(30)
  
  // Location fields
  building            String    @db.VarChar(60)
  floor               String    @db.VarChar(30)
  room                String    @db.VarChar(30)
  locationDescription String?   @db.VarChar(255)
  latitude            Float?
  longitude           Float?
  address             String?   @db.VarChar(255)

  // Relationships
  createdById         String
  createdBy           User      @relation("ComplaintCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedToId        String?
  assignedTo          User?     @relation("ComplaintTechnician", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt          DateTime?

  // Resolution fields
  resolutionNotes     String?   @db.Text
  resolvedAt          DateTime?
  closedAt            DateTime?

  // Resident feedback
  feedbackRating      Int?
  feedbackComments    String?   @db.Text
  feedbackSubmittedAt DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  history             ComplaintHistory[]

  @@index([createdById, createdAt(sort: Desc)])
  @@index([assignedToId, status])
  @@index([status, priority, createdAt(sort: Desc)])
}

model ComplaintHistory {
  id            String    @id @default(uuid())
  complaintId   String
  complaint     Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actorId       String
  actor         User      @relation("HistoryActor", fields: [actorId], references: [id], onDelete: Cascade)
  action        String    @db.VarChar(50)
  previousState Json?
  newState      Json?
  note          String?   @db.Text
  timestamp     DateTime  @default(now())

  @@index([complaintId, timestamp])
}

model EmailVerification {
  id                          String   @id @default(uuid())
  email                       String   @unique @db.VarChar(191)
  otpHash                     String   @db.VarChar(255)
  pendingName                 String   @db.VarChar(60)
  pendingPhone                String?  @db.VarChar(30)
  pendingPasswordHash         String?  @db.VarChar(255)
  pendingRole                 String   @default("user") @db.VarChar(20)
  pendingSpecialization       String?  @db.VarChar(60)
  pendingCustomSpecialization String?  @db.VarChar(100)
  pendingExperience           Int?
  pendingServiceArea          String?  @db.VarChar(100)
  pendingAadhaarMasked        String?  @db.VarChar(30)
  pendingAadhaarHash          String?  @db.VarChar(255)
  verificationToken           String?  @db.VarChar(255)
  attempts                    Int      @default(0)
  lastResendAt                DateTime @default(now())
  expiresAt                   DateTime
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([expiresAt])
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String   @db.VarChar(191)
  tokenHash String   @db.VarChar(255)
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([expiresAt])
}

model Counter {
  id  String @id
  seq Int    @default(0)
}

model TechnicianProfile {
  id                       String    @id @default(uuid())
  userId                   String    @unique
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  primarySpecialization    String    @db.VarChar(60)
  customSpecialization     String?   @db.VarChar(100)
  secondarySpecializations Json?
  experienceYears          Int       @default(0)
  skills                   String?   @db.Text
  serviceArea              String?   @db.VarChar(100)
  workingHours             String?   @db.VarChar(100)
  isAvailable              Boolean   @default(true)
  approvalStatus           String    @default("pending_approval") @db.VarChar(30) // pending_verification, pending_approval, approved, rejected, suspended
  rejectionReason          String?   @db.Text
  approvedAt               DateTime?
  approvedById             String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([approvalStatus, isAvailable])
  @@index([primarySpecialization])
}

model CategoryMapping {
  id                       String   @id @default(uuid())
  category                 String   @unique @db.VarChar(50)
  label                    String   @db.VarChar(100)
  primarySpecialization    String   @db.VarChar(60)
  secondarySpecializations Json?
  description              String?  @db.VarChar(255)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}
